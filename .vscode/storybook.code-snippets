{
  "init storybook": {
    "scope": "typescriptreact",
    "prefix": "!storybook",
    "description": "initialize storybook file",
    "body": [
      "import type { Meta, StoryObj } from 'storybook-framework-qwik';",
      "import { action } from '@storybook/addon-actions';",
      "import { fn } from '@storybook/test';",
      "import { ${1:${TM_DIRECTORY/^.*[\\/](\\w+)/${1:/pascalcase}/}}, type ${1}Props } from './button';",
      "import { $ } from '@builder.io/qwik';",
      "",
      "const meta: Meta<${1}Props> = {",
      "  component: ${1},",
      "  args: {},",
      "argTypes: {},",
      "};",
      "",
      "type Story = StoryObj<${1}Props>;",
      "",
      "export default meta;",
      "",
      "export const Base: Story = {",
      "  render: (props: ${1}Props) => <${1} {...props}>Some button</${1}>,",
      "};"
    ],
  },
  "story action": {
    "scope": "javascriptreact,typescriptreact",
    "prefix": "saction",
    "body": ["$(fn(action('${0:tag}')))"],
  },
}